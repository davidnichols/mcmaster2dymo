{
  "manifest_version": 3,
  "name": "McMaster → DYMO Label",
  "version": "1.2.0",
  "description": "Print DYMO LabelWriter 550 labels for McMaster-Carr parts — one part, or every line of an order: part number, description, picture and a QR code link.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Print DYMO labels for this McMaster part or order",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the label popup"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.mcmaster.com/*",
    "https://*.mcmaster.com/*",
    "https://127.0.0.1:41951/*",
    "https://localhost:41951/*"
  ]
}
